# Normalize line endings; binaries stay untouched
* text=auto

# Source files
*.kt    text eol=lf
*.kts   text eol=lf
*.java  text eol=lf
*.xml   text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.json  text eol=lf
*.md    text eol=lf
*.gradle text eol=lf

# Binary / generated artifacts
*.apk   binary
*.aab   binary
*.png   binary
*.jpg   binary
*.webp  binary
*.keystore binary
*.jks   binary