<?xml version="1.0" encoding="utf-8"?>
<shortcuts xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- Prayer Times Shortcut -->
    <shortcut
        android:shortcutId="prayer_times"
        android:enabled="true"
        android:icon="@drawable/ic_prayer_times"
        android:shortcutShortLabel="@string/shortcut_prayer_times"
        android:shortcutLongLabel="@string/shortcut_prayer_times_long"
        android:shortcutDisabledMessage="@string/shortcut_prayer_times_disabled">
        <intent
            android:action="android.intent.action.VIEW"
            android:targetPackage="com.praytracker"
            android:targetClass="com.praytracker.MainActivity">
            <extra
                android:name="shortcut_id"
                android:value="prayer_times" />
        </intent>
    </shortcut>
    
